sequenceDiagram
    participant Client
    participant Dijkstra
    participant Graph
    participant DijkstraLoop as dijkstra_loop
    participant ProcessNeighbors as process_neighbors
    participant ReconstructPath as reconstruct_path

    Note over Client, ReconstructPath: Dijkstra's Algorithm Execution<br/>Graph: A->B(4), A->C(2)<br/>Find shortest path from "A" to "B"

    %% Initial call
    Client->>+Dijkstra: shortest_path(graph, "A", "B")
    
    %% Build shortest path tree
    Dijkstra->>+Dijkstra: shortest_path_tree(graph, "A")
    
    %% Get all nodes
    Dijkstra->>+Graph: all_nodes(graph)
    Graph-->>-Dijkstra: ["A", "B", "C"]
    
    %% Initialize distances
    Note over Dijkstra: Initialize distances:<br/>%{"A" => {0, nil}, "B" => {:infinity, nil}, "C" => {:infinity, nil}}
    Note over Dijkstra: Initialize queue: [{0, "A"}]<br/>Initialize visited: MapSet.new()
    
    %% Start main algorithm loop
    Dijkstra->>+DijkstraLoop: dijkstra_loop(graph, [{0, "A"}], distances, visited)
    
    %% First iteration - process node "A"
    Note over DijkstraLoop: Sort queue: [{0, "A"}]<br/>Extract: {0, "A"}
    Note over DijkstraLoop: "A" not visited, mark as visited
    
    %% Get neighbors of A
    DijkstraLoop->>+Graph: neighbors(graph, "A")
    Graph-->>-DijkstraLoop: [{"C", 2}, {"B", 4}]
    
    %% Process neighbors
    DijkstraLoop->>+ProcessNeighbors: process_neighbors([{"C", 2}, {"B", 4}], "A", 0, [], distances, visited)
    
    Note over ProcessNeighbors: Process neighbor "C":<br/>new_distance = 0 + 2 = 2<br/>2 < :infinity, update distances["C"] = {2, "A"}
    Note over ProcessNeighbors: Process neighbor "B":<br/>new_distance = 0 + 4 = 4<br/>4 < :infinity, update distances["B"] = {4, "A"}
    
    ProcessNeighbors-->>-DijkstraLoop: {[{4, "B"}, {2, "C"}], updated_distances}
    
    %% Continue loop with updated queue
    DijkstraLoop->>+DijkstraLoop: dijkstra_loop(graph, [{2, "C"}, {4, "B"}], distances, visited)
    
    %% Second iteration - process node "C" (lowest distance)
    Note over DijkstraLoop: Sort queue: [{2, "C"}, {4, "B"}]<br/>Extract: {2, "C"}
    Note over DijkstraLoop: "C" not visited, mark as visited
    
    %% Get neighbors of C
    DijkstraLoop->>+Graph: neighbors(graph, "C")
    Graph-->>-DijkstraLoop: []
    
    %% Process empty neighbors
    DijkstraLoop->>+ProcessNeighbors: process_neighbors([], "C", 2, [{4, "B"}], distances, visited)
    ProcessNeighbors-->>-DijkstraLoop: {[{4, "B"}], distances}
    
    %% Continue loop
    DijkstraLoop->>+DijkstraLoop: dijkstra_loop(graph, [{4, "B"}], distances, visited)
    
    %% Third iteration - process node "B"
    Note over DijkstraLoop: Sort queue: [{4, "B"}]<br/>Extract: {4, "B"}
    Note over DijkstraLoop: "B" not visited, mark as visited
    
    %% Get neighbors of B
    DijkstraLoop->>+Graph: neighbors(graph, "B")
    Graph-->>-DijkstraLoop: []
    
    %% Process empty neighbors
    DijkstraLoop->>+ProcessNeighbors: process_neighbors([], "B", 4, [], distances, visited)
    ProcessNeighbors-->>-DijkstraLoop: {[], distances}
    
    %% Final iteration - empty queue
    DijkstraLoop->>+DijkstraLoop: dijkstra_loop(graph, [], distances, visited)
    Note over DijkstraLoop: Queue empty, return final distances
    DijkstraLoop-->>-DijkstraLoop: distances
    DijkstraLoop-->>-DijkstraLoop: distances
    DijkstraLoop-->>-DijkstraLoop: distances
    DijkstraLoop-->>-Dijkstra: %{"A" => {0, nil}, "B" => {4, "A"}, "C" => {2, "A"}}
    
    %% Back to shortest_path
    Dijkstra-->>-Dijkstra: distances
    
    Note over Dijkstra: Get distance to "B": {4, "A"}
    Note over Dijkstra: Distance is not :infinity, reconstruct path
    
    %% Reconstruct path
    Dijkstra->>+ReconstructPath: reconstruct_path(distances, "A", "B")
    ReconstructPath->>+ReconstructPath: build_path(distances, "B", ["B"], "A")
    
    Note over ReconstructPath: Get previous of "B": "A"<br/>Current != source, continue
    ReconstructPath->>+ReconstructPath: build_path(distances, "A", ["A", "B"], "A")
    Note over ReconstructPath: Current == source, return path
    ReconstructPath-->>-ReconstructPath: ["A", "B"]
    ReconstructPath-->>-Dijkstra: ["A", "B"]
    
    %% Final result
    Dijkstra-->>-Client: {:ok, {4, ["A", "B"]}}
    
    Note over Client: Result: Distance = 4, Path = ["A", "B"]
