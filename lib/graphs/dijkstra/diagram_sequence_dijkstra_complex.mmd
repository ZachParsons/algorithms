sequenceDiagram
    participant Client
    participant Dijkstra
    participant Graph
    participant DijkstraLoop as dijkstra_loop
    participant ProcessNeighbors as process_neighbors
    participant ReconstructPath as reconstruct_path

    Note over Client, ReconstructPath: Dijkstra's Algorithm - Complex Example<br/>Graph: A->B(4), A->C(2), B->C(1), B->D(5), C->D(8)<br/>Find shortest path from "A" to "D"

    %% Initial call
    Client->>+Dijkstra: shortest_path(graph, "A", "D")
    
    %% Build shortest path tree
    Dijkstra->>+Dijkstra: shortest_path_tree(graph, "A")
    
    %% Get all nodes
    Dijkstra->>+Graph: all_nodes(graph)
    Graph-->>-Dijkstra: ["A", "B", "C", "D"]
    
    %% Initialize distances
    Note over Dijkstra: Initialize distances:<br/>%{"A" => {0, nil}, "B" => {:infinity, nil},<br/>"C" => {:infinity, nil}, "D" => {:infinity, nil}}
    Note over Dijkstra: Initialize queue: [{0, "A"}]<br/>Initialize visited: MapSet.new()
    
    %% Start main algorithm loop
    Dijkstra->>+DijkstraLoop: dijkstra_loop(graph, [{0, "A"}], distances, visited)
    
    %% ITERATION 1: Process node "A" (distance 0)
    Note over DijkstraLoop: **ITERATION 1**<br/>Sort queue: [{0, "A"}]<br/>Extract: {0, "A"}, mark visited
    
    DijkstraLoop->>+Graph: neighbors(graph, "A")
    Graph-->>-DijkstraLoop: [{"C", 2}, {"B", 4}]
    
    DijkstraLoop->>+ProcessNeighbors: process_neighbors([{"C", 2}, {"B", 4}], "A", 0, [], distances, visited)
    
    Note over ProcessNeighbors: Process "C": 0 + 2 = 2 < ∞<br/>Update distances["C"] = {2, "A"}<br/>Add {2, "C"} to queue
    Note over ProcessNeighbors: Process "B": 0 + 4 = 4 < ∞<br/>Update distances["B"] = {4, "A"}<br/>Add {4, "B"} to queue
    
    ProcessNeighbors-->>-DijkstraLoop: {[{4, "B"}, {2, "C"}], updated_distances}
    
    %% ITERATION 2: Process node "C" (distance 2)
    DijkstraLoop->>+DijkstraLoop: dijkstra_loop(graph, [{2, "C"}, {4, "B"}], distances, visited)
    
    Note over DijkstraLoop: **ITERATION 2**<br/>Sort queue: [{2, "C"}, {4, "B"}]<br/>Extract: {2, "C"}, mark visited
    
    DijkstraLoop->>+Graph: neighbors(graph, "C")
    Graph-->>-DijkstraLoop: [{"D", 8}]
    
    DijkstraLoop->>+ProcessNeighbors: process_neighbors([{"D", 8}], "C", 2, [{4, "B"}], distances, visited)
    
    Note over ProcessNeighbors: Process "D": 2 + 8 = 10 < ∞<br/>Update distances["D"] = {10, "C"}<br/>Add {10, "D"} to queue
    
    ProcessNeighbors-->>-DijkstraLoop: {[{10, "D"}, {4, "B"}], updated_distances}
    
    %% ITERATION 3: Process node "B" (distance 4)
    DijkstraLoop->>+DijkstraLoop: dijkstra_loop(graph, [{4, "B"}, {10, "D"}], distances, visited)
    
    Note over DijkstraLoop: **ITERATION 3**<br/>Sort queue: [{4, "B"}, {10, "D"}]<br/>Extract: {4, "B"}, mark visited
    
    DijkstraLoop->>+Graph: neighbors(graph, "B")
    Graph-->>-DijkstraLoop: [{"D", 5}, {"C", 1}]
    
    DijkstraLoop->>+ProcessNeighbors: process_neighbors([{"D", 5}, {"C", 1}], "B", 4, [{10, "D"}], distances, visited)
    
    Note over ProcessNeighbors: Process "D": 4 + 5 = 9 < 10 (current)<br/>Update distances["D"] = {9, "B"} ✓ BETTER PATH!<br/>Add {9, "D"} to queue
    Note over ProcessNeighbors: Process "C": already visited, skip
    
    ProcessNeighbors-->>-DijkstraLoop: {[{9, "D"}, {10, "D"}], updated_distances}
    
    %% ITERATION 4: Process node "D" (distance 9)
    DijkstraLoop->>+DijkstraLoop: dijkstra_loop(graph, [{9, "D"}, {10, "D"}], distances, visited)
    
    Note over DijkstraLoop: **ITERATION 4**<br/>Sort queue: [{9, "D"}, {10, "D"}]<br/>Extract: {9, "D"}, mark visited
    
    DijkstraLoop->>+Graph: neighbors(graph, "D")
    Graph-->>-DijkstraLoop: []
    
    DijkstraLoop->>+ProcessNeighbors: process_neighbors([], "D", 9, [{10, "D"}], distances, visited)
    ProcessNeighbors-->>-DijkstraLoop: {[{10, "D"}], distances}
    
    %% ITERATION 5: Process duplicate "D" (distance 10) - will be skipped
    DijkstraLoop->>+DijkstraLoop: dijkstra_loop(graph, [{10, "D"}], distances, visited)
    
    Note over DijkstraLoop: **ITERATION 5**<br/>Sort queue: [{10, "D"}]<br/>Extract: {10, "D"}, already visited - SKIP
    
    %% ITERATION 6: Empty queue
    DijkstraLoop->>+DijkstraLoop: dijkstra_loop(graph, [], distances, visited)
    Note over DijkstraLoop: **FINAL**<br/>Queue empty, return distances
    
    DijkstraLoop-->>-DijkstraLoop: final_distances
    DijkstraLoop-->>-DijkstraLoop: final_distances  
    DijkstraLoop-->>-DijkstraLoop: final_distances
    DijkstraLoop-->>-DijkstraLoop: final_distances
    DijkstraLoop-->>-Dijkstra: %{"A" => {0, nil}, "B" => {4, "A"}, "C" => {2, "A"}, "D" => {9, "B"}}
    
    %% Back to shortest_path
    Dijkstra-->>-Dijkstra: distances
    
    Note over Dijkstra: Get distance to "D": {9, "B"}<br/>Distance is not :infinity, reconstruct path
    
    %% Reconstruct path
    Dijkstra->>+ReconstructPath: reconstruct_path(distances, "A", "D")
    ReconstructPath->>+ReconstructPath: build_path(distances, "D", ["D"], "A")
    
    Note over ReconstructPath: Get previous of "D": "B"<br/>Add "B" to path: ["B", "D"]
    ReconstructPath->>+ReconstructPath: build_path(distances, "B", ["B", "D"], "A")
    
    Note over ReconstructPath: Get previous of "B": "A"<br/>Add "A" to path: ["A", "B", "D"]
    ReconstructPath->>+ReconstructPath: build_path(distances, "A", ["A", "B", "D"], "A")
    
    Note over ReconstructPath: Current == source, return path
    ReconstructPath-->>-ReconstructPath: ["A", "B", "D"]
    ReconstructPath-->>-ReconstructPath: ["A", "B", "D"]
    ReconstructPath-->>-Dijkstra: ["A", "B", "D"]
    
    %% Final result
    Dijkstra-->>-Client: {:ok, {9, ["A", "B", "D"]}}
    
    Note over Client: **RESULT**<br/>Distance = 9 (A->B->D: 4+5)<br/>Path = ["A", "B", "D"]<br/>Better than A->C->D: 2+8=10
